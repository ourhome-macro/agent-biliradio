[Unit]
Description=Recommend Radio worker and durable outbox
Requires=recommend-radio-migrate.service
After=recommend-radio-migrate.service network-online.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/agent-memory-runtime/recommend-radio/backend
EnvironmentFile=/etc/recommend-radio/radio.env
Environment=AMEM_TRANSPORT=embedded
Environment=AUTO_DREAM_ENABLED=true
Environment=RADIO_OUTBOX_EMBEDDED=true
Environment=SSE_GATEWAY_INTERNAL_URL=
ExecStart=/opt/agent-memory-runtime/.venv/bin/python -m celery -A task_app worker --pool=prefork --concurrency=4 --hostname=radio@%%h -Q radio.jobs.v2,radio.events.v2
Restart=on-failure
RestartSec=3
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
