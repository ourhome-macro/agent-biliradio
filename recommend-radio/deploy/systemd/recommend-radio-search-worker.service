[Unit]
Description=Recommend Radio Kafka to authorized content search projection
Requires=recommend-radio-migrate.service
After=recommend-radio-migrate.service network-online.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/agent-memory-runtime/recommend-radio/backend
EnvironmentFile=/etc/recommend-radio/radio.env
EnvironmentFile=/etc/recommend-radio/search-writer.env
Environment=AMEM_ENABLED=false
ExecStart=/opt/agent-memory-runtime/.venv/bin/python -m content_search.worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
