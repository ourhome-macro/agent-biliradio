# Copy to /etc/recommend-radio/radio.env and fill credentials before enabling units.
APP_DATA_DIR=/var/lib/recommend-radio
AMEM_DB_PATH=/var/lib/recommend-radio/amem.sqlite3
FRONTEND_DIST=/opt/agent-memory-runtime/recommend-radio/frontend/dist
AMEM_TRANSPORT=embedded
DATABASE_URL=mysql+pymysql://radio_app:replace-me@127.0.0.1:13307/radio_acceptance
REQUIRE_DB_MIGRATION=1
JOB_TRANSPORT=kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_TOPIC_PREFIX=radio
KAFKA_TOPIC_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
RADIO_OUTBOX_EMBEDDED=false
RABBITMQ_ENABLED=false
FEED_REDIS_URL=redis://127.0.0.1:16379/0
UGC_ENABLED=true
CONTENT_SEARCH_ENABLED=true
SEARCH_ES_URL=http://127.0.0.1:19200
SEARCH_ES_INDEX=radio-content-v1
SEARCH_ES_READ_USER=radio_search
SEARCH_ES_READ_PASSWORD=replace-me
# SEARCH_ES_WRITE_PASSWORD belongs only in the search worker environment.
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_PUBLIC_ENDPOINT=https://media.example.com
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MEDIA_BUCKET=radio-media
MEDIA_WORKDIR=/var/lib/recommend-radio/media-work
AUTH_MODE=oidc
APP_SECRET_KEY=replace-me-with-a-stable-random-value
APP_EXTERNAL_URL=https://radio.example.com
APP_DOMAIN=radio.example.com
APP_TRUSTED_HOSTS=radio.example.com
SESSION_COOKIE_SECURE=true
OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=bilibili-radio
OIDC_CLIENT_SECRET=replace-me
AMEM_EMBEDDING_MODEL=bge-m3
AMEM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
AMEM_EMBEDDING_DIMENSIONS=1024
AMEM_EMBEDDING_API_KEY_ENV=BGE_M3_API_KEY
BGE_M3_API_KEY=replace-me
RECOMMEND_LLM_PROVIDER=deepseek
RECOMMEND_LLM_MODEL=deepseek-chat
SSE_EVENT_RETENTION_DAYS=7
