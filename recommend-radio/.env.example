# Public HTTPS origin. Production Compose uses Caddy and requires a real DNS name.
APP_DOMAIN=radio.example.com
ACME_EMAIL=admin@example.com

# Application OIDC client. Register this exact callback URL:
# https://radio.example.com/api/session/callback
AUTH_MODE=oidc
# Stable across backend, workers and AMEM; also encrypts per-user DeepSeek keys.
# Generate a random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-python-secrets-token-urlsafe-48
APP_EXTERNAL_URL=https://radio.example.com
APP_TRUSTED_HOSTS=radio.example.com
APP_SESSION_TTL_SECONDS=604800
APP_SESSION_IDLE_SECONDS=86400
APP_ADMIN_SESSION_TTL_SECONDS=28800
APP_SESSION_MAX_ACTIVE=5
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=

# RabbitMQ behavior bus. Generate a unique production password; the Compose
# defaults are only for loopback-bound local development.
RABBITMQ_USER=radio
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# The settings below describe the optional legacy v1 drain topology.
# Active Celery queues: radio.jobs.v2 / radio.events.v2.
RABBITMQ_EXCHANGE=recommend-radio.events.v1
RABBITMQ_BEHAVIOR_ROUTING_KEY=behavior.music
RABBITMQ_BEHAVIOR_QUEUE=recommend-radio.amem.behavior.v1
RABBITMQ_DEAD_LETTER_EXCHANGE=recommend-radio.dlx.v1
RABBITMQ_BEHAVIOR_DLQ=recommend-radio.amem.behavior.dlq.v1
RABBITMQ_DELIVERY_LIMIT=8
RABBITMQ_PREFETCH_COUNT=16

OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=bilibili-radio
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_SCOPES=openid profile email groups
OIDC_ADMIN_GROUP=

# Set these before the first OIDC login so existing local music data is claimed
# by your immutable (issuer, subject) identity.
OIDC_BOOTSTRAP_ADMIN_ISSUER=https://idp.example.com
OIDC_BOOTSTRAP_ADMIN_SUBJECT=replace-with-your-immutable-sub
OIDC_ALLOW_HTTP=false

# Prometheus scrape authentication. Use at least 32 random bytes.
METRICS_BEARER_TOKEN=replace-with-a-long-random-metrics-token
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=2GB
ALERTMANAGER_RETENTION_TIME=120h

# Host Web/Worker use embedded AMEM and SQLite-backed Python SSE.
# The local startup script overrides Docker-style addresses below.
AMEM_TRANSPORT=embedded
RADIO_OUTBOX_EMBEDDED=true
APP_DATA_DIR=
FRONTEND_DIST=

# Recommendation LLM + AMEM memory loop.
AMEM_ENABLED=true
AUTO_DREAM_ENABLED=true
AUTO_DREAM_LLM_ENABLED=true
AUTO_DREAM_TIMEZONE=Asia/Shanghai
AMEM_DB_PATH=/app/data/amem.sqlite3
AMEM_CORE_PROMOTION_MIN_AGE_DAYS=2
AMEM_RETRIEVAL_ROUTE_MUSIC_RECOMMENDATION=lexical_first
AMEM_RETRIEVAL_ROUTE_CONVERSATION=hybrid
RECOMMEND_LLM_ENABLED=true
RECOMMEND_DIALOGUE_ROUTER_LLM_ENABLED=true
RECOMMEND_LLM_PROVIDER=deepseek
RECOMMEND_LLM_MODEL=deepseek-chat
# Optional legacy/internal key. User-facing assistant calls require each user's own key.
DEEPSEEK_API_KEY=
RECOMMEND_LLM_TIMEOUT_SECONDS=8
RECOMMEND_LLM_TEMPERATURE=0.2
RECOMMEND_LLM_TOP_P=0.95
RECOMMEND_LLM_MAX_TOKENS=3000
RECOMMEND_LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}
RECOMMEND_LLM_JSON_RESPONSE=true
RECOMMEND_LLM_ATTEMPTS=2
RECOMMEND_AGENT_SEARCH_BUDGET=3
RECOMMEND_PROFILE_TTL_SECONDS=600

# Candidate-stage semantic validation. BGE-M3 must expose an OpenAI-compatible
# /embeddings endpoint. Missing URL/key disables the client without failing
# recommendation requests.
RECOMMEND_EMBEDDING_ENABLED=true
RECOMMEND_EMBEDDING_BASE_URL=
RECOMMEND_EMBEDDING_API_KEY_ENV=BGE_M3_API_KEY
BGE_M3_API_KEY=
RECOMMEND_EMBEDDING_MODEL=bge-m3
RECOMMEND_EMBEDDING_DIMENSIONS=1024
RECOMMEND_EMBEDDING_TIMEOUT=8s
RECOMMEND_EMBEDDING_CACHE_TTL=168h

# AMEM semantic retrieval. By default docker-compose connects to the local
# embedding_server.py process on the host; it loads the existing BAAI/bge-m3 cache.
# Override the URL, model and key only when using a hosted OpenAI-compatible provider.
AMEM_EMBEDDING_PROVIDER=openai-compatible
AMEM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
AMEM_EMBEDDING_API_KEY_ENV=BGE_M3_API_KEY
AMEM_EMBEDDING_MODEL=bge-m3
AMEM_EMBEDDING_MODEL_VERSION=default
AMEM_EMBEDDING_DIMENSIONS=1024
AMEM_EMBEDDING_TIMEOUT_SECONDS=15
AMEM_EMBEDDING_NORMALIZED=true
AMEM_EMBEDDING_MIN_SIMILARITY=0.45
BGE_M3_API_KEY=local-embedding

# Persisted candidate embeddings. Audio jobs are disabled until a CLAP-compatible
# /audio-embeddings service is configured. Only liked/completed tracks and tracks
# admitted by high-yield keywords are eligible for audio embedding.
RECOMMEND_AUDIO_EMBEDDING_BASE_URL=
RECOMMEND_AUDIO_EMBEDDING_MODEL=laion-clap
RECOMMEND_AUDIO_EMBEDDING_MODEL_VERSION=default

# Optional user-level experiments. Disabled means the production behavior is
# unchanged; enabled assignments are stable and persisted per user.
RECOMMEND_MEMORY_AB_ENABLED=false
RECOMMEND_MEMORY_AB_TREATMENT_PERCENT=50
RECOMMEND_KEYWORD_AB_ENABLED=false
RECOMMEND_KEYWORD_AB_TREATMENT_PERCENT=50

# Keyword evidence decay and UCB exploration.
RECOMMEND_KEYWORD_FEEDBACK_HALF_LIFE_DAYS=14
RECOMMEND_KEYWORD_YIELD_HALF_LIFE_DAYS=7
RECOMMEND_KEYWORD_MIN_EXPOSURES=20
RECOMMEND_KEYWORD_UCB_COEFFICIENT=0.18

# Optional supply lanes. Comma-separated Bilibili favorite media IDs.
RECOMMEND_DISCOVERY_FAVORITE_MEDIA_IDS=
RECOMMEND_PREFILTER_MODE=shadow
RECOMMEND_PREFILTER_POSITIVE_PASS=0.70
RECOMMEND_PREFILTER_POSITIVE_REJECT=0.20
RECOMMEND_PREFILTER_NEGATIVE_REJECT=0.65
RECOMMEND_PREFILTER_NEGATIVE_PASS_MAX=0.30
RECOMMEND_LLM_EVALUATOR_ENABLED=false

# Internal Python -> Go SSE event channel. Replace in production.
SSE_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
# Set only while running the explicit legacy full-container stack.
SSE_GATEWAY_INTERNAL_URL=
SSE_EVENT_RETENTION_DAYS=7

# Grafana has a separate OIDC client. Register this exact callback URL:
# https://radio.example.com/grafana/login/generic_oauth
GRAFANA_ADMIN_USER=local-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-password
GRAFANA_OIDC_ENABLED=true
GRAFANA_OIDC_CLIENT_ID=bilibili-radio-grafana
GRAFANA_OIDC_CLIENT_SECRET=replace-with-grafana-oidc-client-secret
GRAFANA_OIDC_SCOPES=openid profile email groups
GRAFANA_OIDC_AUTH_URL=https://idp.example.com/authorize
GRAFANA_OIDC_TOKEN_URL=https://idp.example.com/token
GRAFANA_OIDC_USERINFO_URL=https://idp.example.com/userinfo
GRAFANA_OIDC_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'bilibili-radio-admins') && 'GrafanaAdmin'
GRAFANA_OIDC_ROLE_ATTRIBUTE_STRICT=true
GRAFANA_OIDC_LOGIN_ATTRIBUTE_PATH=preferred_username
GRAFANA_OIDC_EMAIL_ATTRIBUTE_PATH=email
GRAFANA_DISABLE_LOGIN_FORM=false
# Music video Feed is opt-in; existing host MinIO serves completed business assets.
FEED_ENABLED=false
JOB_TRANSPORT=redis_stream
JOB_REDIS_URL=redis://127.0.0.1:6379/1
REDIS_SERVER_PATH=
FEED_SESSION_SECONDS=1800
FEED_REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MEDIA_BUCKET=radio-media
MEDIA_WORKDIR=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_BYTES=2147483648
MEDIA_MAX_DURATION_SECONDS=3600
MEDIA_SCRATCH_BYTES=10737418240
MEDIA_STORAGE_BYTES=107374182400
MEDIA_PLAYBACK_LEASE_SECONDS=15
MEDIA_CANCEL_GRACE_SECONDS=3
MEDIA_IMPORT_HEARTBEAT_SECONDS=10
MEDIA_IMPORT_LEASE_SECONDS=120
MEDIA_FETCH_MAX_ATTEMPTS=3
MEDIA_SIGNED_SECONDS=7200
MEDIA_WORKER_CONCURRENCY=2
MEDIA_IMPORT_BUDGET_SECONDS=3600
RECOMMEND_INPUT_COST_PER_MILLION_USD=
RECOMMEND_OUTPUT_COST_PER_MILLION_USD=
